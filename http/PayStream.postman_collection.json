  },
  "item": [
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Save the new payment id so \"Get payment\" can use it\r",
                  "if (pm.response.code === 201) {\r",
                  "    pm.collectionVariables.set(\"paymentId\", pm.response.json().paymentId);\r",
                  "}\r",
                  "\r",
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));\r",
                  "pm.test(\"Location points to the gateway\", () => {\r",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.include(\"localhost:8080\");\r",
                  "});\r",
                  "pm.test(\"Timestamps are populated\", () => {\r",
                  "    const body = pm.response.json();\r",
                  "    pm.expect(body.createdAt).to.not.be.null;\r",
                  "    pm.expect(body.updatedAt).to.not.be.null;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text",
                "disabled": true
              },
              {
                "key": "",
                "value": "",
                "type": "text",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"payerAccount\": \"ACC1000000001\",\r\n  \"payeeAccount\": \"ACC1000000002\",\r\n  \"amount\": 250.00,\r\n  \"currency\": \"INR\",\r\n  \"reference\": \"Rent for October\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            }
          },
          "response": []
        },
